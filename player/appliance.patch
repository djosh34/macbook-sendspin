-            match cpal::host_from_id(cpal::HostId::PipeWire) {
-                Ok(host) => {
-                    info!("Using PipeWire audio host");
-                    return host;
-                }
-                Err(err) => {
-                    warn!(
-                        "PipeWire audio host unavailable ({}), falling back to default host",
-                        err
-                    );
-                }
-            }
-        }
-        cpal::default_host()
-    }
