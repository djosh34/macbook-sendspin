+    let bytes = samples.and_then(|samples| samples.checked_mul(std::mem::size_of::<Sample>()));
+    if queue.len() >= MAX_QUEUED_BUFFERS || bytes.is_none_or(|bytes| bytes > QUEUE_CAPACITY_BYTES) {
+        return Err(SendspinError::Audio("audio queue capacity exceeded".into()));
+    }
+    if front { queue.push_front(buffer); } else { queue.push_back(buffer); }
+    Ok(())
