+
+fn require_exact_rate(requested: u32, actual: u32) -> Result<(), SendspinError> {
+    if requested != actual {
+        return Err(SendspinError::Audio(format!("ALSA rate mismatch: requested {}Hz, got {}Hz", requested, actual)));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rejects_rate_drift_instead_of_resampling() {
+        assert!(require_exact_rate(44100, 44100).is_ok());
+        assert!(require_exact_rate(48000, 48000).is_ok());
+        assert!(require_exact_rate(44100, 48000).is_err());
+        assert!(require_exact_rate(48000, 44100).is_err());
+    }
+}
