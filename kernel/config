# Minimal built-in x86-64 q35/KVM kernel, applied with allnoconfig.
# VFIO/IOMMU drivers belong to the host, not this passed-device guest.
CONFIG_64BIT=y
CONFIG_EXPERT=y
CONFIG_X86_64=y
CONFIG_SMP=n
CONFIG_X86_X2APIC=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_GENERIC_CPU=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_QUIRKS=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT=y
CONFIG_PM=y
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_EFI=n
CONFIG_X86_5LEVEL=n
CONFIG_MODULES=n
CONFIG_BLOCK=n

# LinuxKit initramfs, native BusyBox init, mount/IPC/UTS sandbox and runtime RAM.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
CONFIG_SHMEM=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SYSVIPC=y
CONFIG_CGROUPS=n
CONFIG_KEYS=n
CONFIG_PID_NS=n
CONFIG_NET_NS=n
CONFIG_USER_NS=n
CONFIG_UNIX98_PTYS=n
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Direct virtio NIC: KubeVirt masquerading is outside the guest.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=n
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_ETHERNET=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_NETFILTER=n
CONFIG_NET_SCHED=n

# The passed Intel 8086:1e20 controller and CS4206 need no guest VFIO.
# Cirrus selects the shared generic HDA parser, not another codec driver.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_DYNAMIC_MINORS=n
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
CONFIG_SND_SUPPORT_OLD_API=n
CONFIG_SND_VERBOSE_PROCFS=n
CONFIG_SND_HDA_INPUT_BEEP=n
CONFIG_SND_HDA_RECONFIG=n
CONFIG_SND_HDA_PATCH_LOADER=n
CONFIG_SND_USB=n
CONFIG_SND_SOC=n

# KubeVirt's ISA UART; no VGA, display, login or unrelated input hardware.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_USB_SUPPORT=n
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_ELF_CORE=n
CONFIG_COREDUMP=n
CONFIG_KALLSYMS=n
# EXPERT selects this menu; individual debug instrumentation remains disabled.
CONFIG_DEBUG_KERNEL=y
CONFIG_LOCALVERSION="-sendspin"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_BUILD_SALT=""
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_DEFAULT_HOSTNAME="sendspin"
